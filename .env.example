# Copiar a .env.local en desarrollo.
# En Vercel: Project → Settings → Environment Variables (Production + Preview).

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mi Figurita — Gemini (Google AI Studio). Solo servidor; nunca NEXT_PUBLIC_*.
# Acepta cualquiera de estas (la primera definida gana):
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Opcional. Ej.: gemini-2.0-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Tras desplegar, en Supabase → Auth → URL configuration agrega tu dominio Vercel.
