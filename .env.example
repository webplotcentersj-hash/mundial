# Copiar a .env.local en desarrollo.
# En Vercel: Project → Settings → Environment Variables (Production + Preview).

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mi Figurita — Gemini (Google AI Studio). Solo servidor; nunca NEXT_PUBLIC_*.
# Acepta cualquiera de estas (la primera definida gana):
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Opcional. Si el modelo falla, el servidor prueba otros en cadena.
# Ej.: gemini-3-flash-preview, gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=

# Tras desplegar, en Supabase → Auth → URL configuration agrega tu dominio Vercel.

# Store — Mercado Pago Checkout Pro (solo servidor; credenciales de producción o prueba)
# https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
# URL pública del sitio (webhooks y retorno de pago). En Vercel suele inferirse; en local:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=
# Webhook: Supabase service role para actualizar pedidos al confirmar el pago
SUPABASE_SERVICE_ROLE_KEY=
