# Copiar a .env.local en desarrollo.
# En Vercel: Project → Settings → Environment Variables (Production + Preview).

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mi Figurita — Gemini (Google AI Studio). Solo servidor; no uses NEXT_PUBLIC_.
GEMINI_API_KEY=
# Opcional. Ejemplos: gemini-2.5-flash, gemini-2.0-flash, gemini-3-flash-preview (según disponibilidad en tu proyecto).
GEMINI_MODEL=gemini-2.5-flash

# Tras desplegar, en Supabase → Auth → URL configuration agrega tu dominio Vercel.
