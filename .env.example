# Copiar a .env.local en desarrollo.
# En Vercel: Project → Settings → Environment Variables (Production + Preview).

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mi Figurita — Gemini (Google AI Studio). Solo servidor; nunca NEXT_PUBLIC_*.
# Acepta cualquiera de estas (la primera definida gana):
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Opcional. Si el modelo falla, el servidor prueba otros en cadena.
# Ej.: gemini-3-flash-preview, gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=

# Tras desplegar, en Supabase → Auth → URL configuration agrega tu dominio Vercel.

# --- Store: Mercado Pago Checkout Pro ---
# 1) https://www.mercadopago.com.ar/developers/panel/app → tu app → Credenciales
#    Pruebas: Access Token que empieza con TEST- (usuarios de prueba en el panel)
#    Producción: Access Token de producción (cuenta verificada)
MERCADOPAGO_ACCESS_TOKEN=
# 2) Supabase → Project Settings → API → service_role (NUNCA en el cliente)
SUPABASE_SERVICE_ROLE_KEY=
# 3) URL pública (retorno de pago + webhook). Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 4) En MP → Webhooks → URL: {NEXT_PUBLIC_APP_URL}/api/mercadopago/webhook
#    Eventos: Pagos. En local el webhook requiere túnel (ngrok); la página /store/pago/exito también sincroniza.
# 5) Verificar: npm run check:mp  →  GET /api/mercadopago/health
